# WalletConnect / Reown project id (https://cloud.reown.com). Optional — injected wallets (MetaMask) work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Foundry binary overrides for the integration/e2e layers. Defaults are
# ~/.foundry-standard/bin/{anvil,forge} (the side-by-side standard Foundry —
# the machine's bare `forge`/`anvil` are forge-zksync). Override only if your
# standard Foundry lives elsewhere.
# ANVIL_BIN=
# FORGE_BIN=
